<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>mailTester</RootNamespace>
    <AssemblyName>mailTester</AssemblyName>
    <Platforms>AnyCPU;x64;x86</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Core/MailTester.Core.csproj" />
    <PackageReference Include="PDFsharp-GDI" Version="6.2.4" />
    <Compile Remove="Mail/**/*.cs;Monitoring/**/*.cs;Core/**/*.cs;Cli/**/*.cs;tests/**/*.cs" />
    <EmbeddedResource Remove="Core/**/*;Cli/**/*" />
    <None Remove="Core/**/*;Cli/**/*" />
    <EmbeddedResource Remove="tests/**/*" />
    <None Remove="tests/**/*" />
  </ItemGroup>
</Project>
